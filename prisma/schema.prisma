model CustomFieldDefinition {
  id             String             @id @default(cuid())
  organizationId String
  entityType     ConfigEntityType
  key            String
  systemName     String
  displayLabel   String
  description    String?
  fieldType      CustomFieldType
  required       Boolean            @default(false)
  visibleInTable Boolean            @default(true)
  visibleInForm  Boolean            @default(true)
  position       Int                @default(0)
  width          Int                @default(180)
  options        Json?
  defaultValue   Json?
  archivedAt     DateTime?
  version        Int                @default(1)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  values         CustomFieldValue[]

  @@unique([organizationId, id])
  @@unique([organizationId, entityType, key])
  @@unique([organizationId, entityType, systemName])
  @@index([organizationId, archivedAt])
  @@index([organizationId, createdAt])
  @@index([organizationId, updatedAt])
}

model CustomFieldValue {
  id                String                @id @default(cuid())
  organizationId    String
  entityType        ConfigEntityType
  recordId          String
  fieldDefinitionId String
  valueText         String?
  valueNumber       Decimal?              @db.Decimal(18, 4)
  valueBoolean      Boolean?
  valueDate         DateTime?             @db.Date
  valueDateTime     DateTime?
  valueJson         Json?
  version           Int                   @default(1)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  organization      Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fieldDefinition   CustomFieldDefinition @relation(fields: [organizationId, fieldDefinitionId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, id])
  @@unique([organizationId, fieldDefinitionId, recordId])
  @@index([organizationId, fieldDefinitionId])
  @@index([organizationId, entityType, recordId])
  @@index([organizationId, createdAt])
  @@index([organizationId, updatedAt])
}

